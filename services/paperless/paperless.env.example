# Variables for services/paperless. Copy this to paperless.env and fill it in;
# the repo-root .gitignore keeps *.env untracked.
#
# Postgres only applies the database credentials while initialising an empty
# data directory. Rotate later with ALTER ROLE instead.
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=<your-password>

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it logs every session out and invalidates signed tokens. Compose
# interpolates $ in env files, so double any $ in the value.
PAPERLESS_SECRET_KEY=<your-secret-key>

# AI suggestions and chat through Anthropic's OpenAI-compatible endpoint.
# Document content is sent to Anthropic and billed to the key's workspace.
# Keys: https://platform.claude.com/settings/keys
PAPERLESS_AI_LLM_ENDPOINT=https://api.anthropic.com/v1/
PAPERLESS_AI_LLM_API_KEY=<your-anthropic-api-key>
PAPERLESS_AI_LLM_MODEL=claude-haiku-5-5
# Paperless forces tool use and llama-index sends temperature 0.1; Haiku 5.5
# rejects both. Keep these two whatever else is added here.
PAPERLESS_AI_LLM_EXTRA_PARAMS={"temperature": 1, "tool_choice": "auto"}

# Embeddings through Voyage AI, since Anthropic has none. Keys:
# https://dashboard.voyageai.com
#
# Voyage stores and trains on submitted data by default. Before the first start,
# opt out at https://dashboard.voyageai.com/organization/tos (Opted In -> Opted
# Out; needs an org admin and a payment method on file). The opt-out only covers
# data sent afterwards, and gives zero-day retention.
PAPERLESS_AI_LLM_EMBEDDING_ENDPOINT=https://api.voyageai.com/v1
PAPERLESS_AI_LLM_EMBEDDING_API_KEY=<your-voyage-api-key>
PAPERLESS_AI_LLM_EMBEDDING_MODEL=voyage-4-lite
