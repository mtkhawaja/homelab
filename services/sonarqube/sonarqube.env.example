# Credentials for the Postgres container bundled with SonarQube. The same two
# values are used for the database role and for SonarQube's JDBC connection.
#
# This file previously documented SONAR_JDBC_USERNAME and SONAR_JDBC_PASSWORD,
# which the compose file never read. It used the shared POSTGRES_USER and
# POSTGRES_PASSWORD instead, defaulting both to `postgres`.
#
# Postgres only applies these while initialising an empty data directory. On an
# existing deployment they must match what the role was created with, so a fresh
# password here just fails to authenticate. Rotate with ALTER ROLE instead.
SONARQUBE_DB_USER=postgres
SONARQUBE_DB_PASSWORD=<your-password>
