# Variables shared across every service. Copy this to common.env and fill it in;
# the repo-root .gitignore keeps *.env untracked.
#
#   docker compose \
#     --env-file "./services/common.env" \
#     --file "./services/<service>/compose.yaml" up --detach
#
# Services needing secrets of their own keep a second file beside their compose
# file (services/traefik/traefik.env and so on), passed as a second --env-file.
# Both have to be explicit: passing any --env-file disables the automatic .env
# lookup Compose would otherwise do in the compose file's own directory, so a
# service-level file is never picked up on its own.
#
# These are consumed by Compose to interpolate the service files. They are not
# passed into containers unless a service lists them under its own
# `environment:` block; portainer does that deliberately, so stacks deployed
# from within Portainer can resolve them too.

# Host directory that all bind mounts are rooted at. Migrating a service to a
# named volume removes its dependency on this.
BASE_VOLUME_DIRECTORY=/whatever/base/directory/you/want

# The domain services are published under. Traefik labels are written as
# Host(`<service>.$SERVICE_DOMAIN`), so the "local." prefix lives here in the
# value rather than being repeated in every label. Changing the prefix, or
# dropping it, is a one-line edit here instead of an edit in every service.
SERVICE_DOMAIN=local.example.com
