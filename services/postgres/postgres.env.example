# Credentials for the shared Postgres instance and pgAdmin.
#
# These belong to the shared instance only. Services that bundle their own
# database use their own names -- PAPERLESS_DB_*, TWENTY_DB_*, VIKUNJA_DB_*,
# SONARQUBE_DB_*, KEYCLOAK_DB_* -- precisely so that setting these cannot reach
# into those stacks. They used to share POSTGRES_USER and POSTGRES_PASSWORD,
# which meant changing it here silently changed five other databases.
#
# Postgres only applies the first two while initialising an empty data
# directory. On an existing deployment they must match what the role was
# actually created with; changing them here just fails to authenticate. Rotate
# with ALTER ROLE instead.
POSTGRES_USER=<postgres>
POSTGRES_PASSWORD=<your-password>

# Login for the initial pgAdmin administrator account.
PGADMIN_DEFAULT_EMAIL=<admin@example.com>
PGADMIN_DEFAULT_PASSWORD=<your-password>
