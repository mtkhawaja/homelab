# Cloudflare credentials for the ACME DNS-01 challenge, which is how the
# wildcard certificate is issued without anything being reachable from the
# internet. The token needs Zone -> Zone -> Read and Zone -> DNS -> Edit; create
# one at https://dash.cloudflare.com/profile/api-tokens
#
# See the compose file header for the acme.json permissions and for filling in
# the traefik.yml and config.yml templates under ./data.
CF_API_EMAIL=<your-cloudflare-email@example.com>
CF_DNS_API_TOKEN=<replace-this-with-your-cloudflare-api-token>

# htpasswd line guarding the Traefik dashboard. Generate with:
#
#   htpasswd -nbB <user> <password>
#
# Then double every `$` in the hash before pasting it here. Compose interpolates
# $-sequences in values read from an env file, so an unescaped bcrypt hash gets
# truncated at whichever segment happens to look like a variable name, and the
# dashboard login then rejects every password.
#
#   htpasswd output:  admin:$2y$05$abcdefghij
#   what goes here:   admin:$$2y$$05$$abcdefghij
TRAEFIK_BASIC_AUTH=<replace-this-with-your-basic-auth-credentials>
